{
	"name": "schon-wieder",
	"version": "1.0.0",
	"description": "",
	"license": "MIT",
	"author": "",
	"type": "module",
	"main": "index.js",
	"private": true,
	"scripts": {
		"build": "tsx script/build.ts",
		"check": "prettier -c .",
		"dev": "tsx watch --clear-screen=false script/dev.ts",
		"format": "prettier -w .",
		"test": "playwright test",
		"upgrade": "npm-check-updates -u --peer && npm install && npm audit fix"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"express": "^5.3.0",
		"npm-check-updates": "^23.1.1",
		"prettier": "3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"prettier": {
		"printWidth": 100,
		"tabWidth": 3,
		"useTabs": true,
		"singleQuote": true
	},
	"dependencies": {
		"node-html-markdown": "^2.0.0",
		"sass": "^1.105.1"
	},
	"allowScripts": {
		"@parcel/watcher": true,
		"esbuild": true,
		"fsevents": true
	}
}
